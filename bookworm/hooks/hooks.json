{
  "description": "Bookworm: session orientation and agent guards",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact|clear",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/bw-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/session_start.py\"", "timeout": 20 }]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|Write|Edit|MultiEdit|NotebookEdit",
        "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/bw-python\" \"${CLAUDE_PLUGIN_ROOT}/scripts/hooks/guard.py\"", "timeout": 15 }]
      }
    ]
  }
}
