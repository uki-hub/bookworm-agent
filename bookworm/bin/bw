#!/bin/sh
# Bookworm helper shim → scripts/bw.py on the first working Python >= 3.9.
here="$(cd "$(dirname "$0")/.." && pwd)"
for py in "$BOOKWORM_PYTHON" python3 python; do
  [ -n "$py" ] || continue
  if "$py" -c 'import sys; sys.exit(sys.version_info < (3, 9))' >/dev/null 2>&1; then
    exec "$py" "$here/scripts/bw.py" "$@"
  fi
done
echo "bw: no Python >= 3.9 found; install one or set BOOKWORM_PYTHON" >&2
exit 2
